{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "state", "tony_escalations", "sequence", "history"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "state": { "type": "string" },
    "tony_escalations": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "history": { "type": "array" },
    "interrupted": { "type": ["object", "null"] },
    "advisor_case": { "type": ["object", "null"] },
    "exception_handler": { "type": ["string", "null"] },
    "return_after_handler": { "type": ["string", "null"] }
  }
}
